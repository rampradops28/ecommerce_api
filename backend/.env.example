# ==========================================
# BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================
# Copy this file to '.env' and fill in your real credentials.
# NEVER commit the actual '.env' file to Git!

# PostgreSQL Database Connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: If your password contains special characters like '@', URL-encode them (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/ecommerce_db

# Cryptographic Secret for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_secret_key_in_production
